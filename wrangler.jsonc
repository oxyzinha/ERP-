{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eugeen",
  "compatibility_date": "2026-06-03",
  "observability": {
    "enabled": true
  },
  "main": "dist/server/index.mjs",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist/client"
  }
}   